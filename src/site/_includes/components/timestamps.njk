<script src=" https://fastly.jsdelivr.net/npm/luxon@3.2.1/build/global/luxon.min.js "></script>
<script defer>
  (() => {
    if (typeof luxon === 'undefined') return;
    const format = {{meta.timestampSettings.timestampFormat | dump | safe}};
    document.querySelectorAll('.human-date').forEach(function (el) {
      const date = el.getAttribute('data-date') || el.textContent;
      const parsed = luxon.DateTime.fromISO(date);
      if (parsed.isValid) el.textContent = parsed.toFormat(format);
    });
  })();
</script>
